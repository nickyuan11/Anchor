<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml：App 的"清单文件"，告诉系统这个 App 有哪些组件。
  Android 的四大组件（Activity 页面、Service 服务、BroadcastReceiver 广播接收器、
  ContentProvider 内容提供者）都必须在这里登记，系统才会认。
  M2 的无障碍服务也会登记在这里。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11 起，App 默认"看不到"手机上装了哪些其他 App。
      这里声明"我需要看到所有桌面上有图标的 App"，用来把包名显示成 App 名称、
      以及判断窗口类名是不是一个 Activity。不需要用户额外授权。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AnchorApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anchor">

        <!--
          exported="true"：允许系统桌面启动这个页面。
          intent-filter 里的 MAIN + LAUNCHER 表示"它是 App 的入口，在桌面显示图标"。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          FileProvider：把 App 私有目录里的文件，以临时授权链接（content:// 开头）的形式分享给微信等其他 App。
          Android 7.0 起不允许直接把文件路径交给别的 App。可分享的目录见 res/xml/file_paths.xml。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          无障碍服务。
          - permission=BIND_ACCESSIBILITY_SERVICE：只有系统能绑定（启动）它，其他 App 不行
          - meta-data 指向 res/xml/accessibility_config.xml，即服务的能力配置
          - label 是用户在系统"无障碍"设置列表里看到的名字
        -->
        <service
            android:name=".service.SkipAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>

</manifest>
