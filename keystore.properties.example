# 正式包签名配置的模板。
# 用法：把本文件复制一份，改名为 keystore.properties（放在项目根目录），再把下面四项改成你自己的。
# keystore.properties 已被 .gitignore 排除，不会提交到仓库。
#
# 注意：Windows 路径请用正斜杠 /，不要用反斜杠 \（在这种文件里反斜杠是转义符）。

# 钥匙文件的位置。建议放在项目目录之外，例如 D:/develop/keys/anchor-release.jks
storeFile=D:/develop/keys/anchor-release.jks
# 钥匙库密码
storePassword=请改成你的密码
# 钥匙别名（生成钥匙时填的 Alias）
keyAlias=anchor
# 钥匙密码（生成时如果没有单独设置，就和钥匙库密码相同）
keyPassword=请改成你的密码
